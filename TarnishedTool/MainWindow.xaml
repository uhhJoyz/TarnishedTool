<Window x:Class="TarnishedTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TarnishedTool.Controls"
        Title="Tarnished Tool"
        Height="720"
        Width="600"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        BorderBrush="{StaticResource BorderBrush}"
        WindowStyle="SingleBorderWindow"
        AllowsTransparency="False"
        ResizeMode="NoResize"
        InputMethod.IsInputMethodEnabled="False">
    
    <Grid x:Name="RootGrid"
          Margin="0"
          InputMethod.IsInputMethodEnabled="False">
        <Grid.RowDefinitions>
            
            <RowDefinition Height="0" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        
        <controls:TitleBar Title="Tarnished Tool" Visibility="Collapsed" />

        <Grid Grid.Row="1" Margin="0,5,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="AppVersion" Text=""
                       HorizontalAlignment="Left" VerticalAlignment="Center"
                       Width="40"
                       Margin="10,0,0,0" />
            
            <Button x:Name="CheckUpdateButton" Content="Check for Updates"
                    Grid.Column="1"
                    Click="CheckUpdate_Click"
                    Margin="5,0,5,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"/>
            
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="LaunchGameButton" Content="Launch Game"
                        Click="LaunchGame_Click"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"/>
                <TextBlock x:Name="IsAttachedText" Text=""
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           Width="100"
                           Margin="0,0,10,0" />
            </StackPanel>
        </Grid>

        <TabControl x:Name="MainTabControl"
                    Grid.Row="2"
                    Background="Transparent"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top">
                            <TabPanel IsItemsHost="True" HorizontalAlignment="Left" />
                        </Grid>
                        <ContentPresenter ContentSource="SelectedContent" />
                    </DockPanel>
                </ControlTemplate>
            </TabControl.Template>
        </TabControl>

        <Canvas x:Name="SoftwareCursorLayer"
                Grid.RowSpan="3"
                Panel.ZIndex="1000"
                IsHitTestVisible="False"
                Visibility="Visible">
            <Path Fill="White"
                  Stroke="Black"
                  StrokeThickness="1"
                  Data="M 0,0 L 0,20 L 5,15 L 9,24 L 13,22 L 9,14 L 16,14 Z">
                <Path.RenderTransform>
                    <TranslateTransform x:Name="SoftwareCursorTransform" />
                </Path.RenderTransform>
            </Path>
        </Canvas>
    </Grid>
</Window>
